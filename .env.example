# PostgreSQL connection string (matches docker-compose.yml; dev-only credentials)
DATABASE_URL=postgres://jala:jala_dev_password@localhost:5432/jala

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OSRM-compatible routing server. The default is the public demo server:
# fine for the hackathon, not for production traffic.
ROUTING_BASE_URL=https://router.project-osrm.org

# debug | info | warn | error
LOG_LEVEL=info

# Transactional email via Resend. Without a key, emails are only logged.
# RESEND_API_KEY=
# MAIL_FROM=Jala <jala@jala.oak4.xyz>

# Sign in with Google. Create a Web application OAuth client in the Google Auth
# Platform for project hack-the-andes-anti and set both values. The authorized
# redirect URI is ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# (http://localhost:3000/api/auth/google/callback and the production origin).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Web Push notifications (group found, everyone confirmed). Generate a pair with
# `bunx web-push generate-vapid-keys`. Without both keys, notifications are only logged.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:jala@jala.oak4.xyz

# Saved ride preferences (optional; see docs/ride-preferences.md). Both values enable the
# "Preferencias de viaje" card in Cuenta. Server-side only: never use a NEXT_PUBLIC_ name.
# Cloud: https://api.atomicstrata.ai with a project API key from the Atomic Memory console.
# Local demo: `bun run demo:memory-fixture` serves a FIXTURE (not Atomic Memory) on
# http://127.0.0.1:17351 that accepts whatever key you set here.
# ATOMICMEMORY_API_URL=
# ATOMICMEMORY_API_KEY=
